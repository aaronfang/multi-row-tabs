{
  "manifest_version": 3,
  "name": "Multi-Row Tabs",
  "version": "1.0.0",
  "description": "在页面顶部显示多行平铺的标签栏，点击工具栏图标一键切换/还原",
  "permissions": ["tabs", "storage", "scripting", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "切换多行标签栏",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
